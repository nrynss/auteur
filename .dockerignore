# Keep the build context small and, more importantly, keep secrets and local
# artifacts out of an image that will be pushed to a registry.
.env
.venv/
.git/
.pytest_cache/
__pycache__/
*.pyc

# Local artifact scratch — canonical artifacts live in B2.
work/
sfx_cache/
ledger.jsonl

# Not needed at runtime.
tests/
docs/
samples/

# UI build products — the Dockerfile's Node stage builds them fresh from ui/,
# and the Python stage's src/ must stay source-only.
ui/node_modules/
ui/openapi.json
ui/src/lib/api/schema.d.ts
src/foleyflow/api/static/
