# Local / CLI .env — never commit real values.
#
# Cloud Run deploy does NOT load this file. Public config goes in
# env.public.yaml; credentials go to Secret Manager (scripts/setup_secrets.sh)
# and are mounted with --set-secrets (scripts/deploy.sh). Keys marked
# [Secret Manager] below are the ones that must not be plain Cloud Run env.

# Required for VLM analysis and SFX generation via fal.
# Get a key from https://fal.ai — never commit the real value.
# [Secret Manager if deployed] — optional; only when FOLEYFLOW_SFX_TIER needs fal.
FAL_KEY=your-key-here

# Backblaze B2 (S3-compatible API). Create an application key scoped to the bucket.
# Endpoint looks like https://s3.us-west-004.backblazeb2.com
# Non-secret on Cloud Run (env.public.yaml): B2_ENDPOINT_URL, B2_REGION, B2_BUCKET, B2_PREFIX.
B2_ENDPOINT_URL=
B2_REGION=
B2_BUCKET=
# [Secret Manager] → foleyflow-b2-key-id
B2_KEY_ID=
# [Secret Manager] → foleyflow-b2-application-key
B2_APPLICATION_KEY=

# Root prefix for all FoleyFlow objects in the bucket.
B2_PREFIX=foleyflow

# Storage backend for the SFX cache: "local" (dev) or "b2".
FOLEYFLOW_CACHE_BACKEND=b2
FOLEYFLOW_LOCAL_CACHE_DIR=sfx_cache

# Google Gemini — default scene/event analysis. Free tier at
# https://aistudio.google.com/apikey. Either name works; AI Studio labels it
# GEMINI_API_KEY.
# [Secret Manager] → foleyflow-gemini-api-key
GEMINI_API_KEY=

# OpenAI — optional analysis path (gpt-5.6-luna). Default remains Gemini
# (GEMINI_API_KEY above). Same TIMELINE_PROMPT; pass --model gpt-5.6-luna on
# analyze / create. Video is frame-sampled inside the adapter (Luna: image in,
# text out; no native video part).
# [Secret Manager if deployed] — optional; not required for default Gemini path.
OPENAI_API_KEY=

# ElevenLabs — the paid SFX tier (§9.1), reached through the genblaze-elevenlabs
# connector. Only needed when FOLEYFLOW_SFX_TIER=paid; the connector reads this
# variable itself and FoleyFlow never holds the value.
# Get a key at https://elevenlabs.io → Profile → API keys.
# [Secret Manager] → foleyflow-elevenlabs-api-key  (setup_secrets.sh when set)
ELEVENLABS_API_KEY=

# Which SFX tier routing selects: paid | fallback | test. Overrides
# [sfx_tiers] active in providers.toml. Unset means the file decides (test).
FOLEYFLOW_SFX_TIER=

# Self-hosted SFX worker (§9.1). Set to the tunnel URL when the worker is not
# on loopback. Non-secret on Cloud Run (env.public.yaml).
FOLEYFLOW_SFX_WORKER_URL=

# Bearer token for the self-hosted SFX worker, sent on /generate and on the
# /files/{name} download. Leave EMPTY for a loopback worker running open — an
# empty value sends no Authorization header at all, which is what the worker
# expects when it has no token of its own. Must match the worker's
# FOLEYFLOW_SFX_WORKER_TOKEN. Never part of the SFX cache key: it is a
# transport credential, and rotating it must not orphan cached stems.
# [Secret Manager] → foleyflow-sfx-worker-token
FOLEYFLOW_SFX_WORKER_TOKEN=

# Optional. When unset (the default), the cost ledger is one immutable object
# per call under ledger/{ulid}.json on the shared storage backend — the same
# B2/local store as every other artifact, so quota survives instance restarts.
# Set this only to force the historical single-file JSONL path (offline tests,
# deliberate local overrides). Do NOT point it at /tmp on Cloud Run: /tmp is
# per-instance and the counting window dies with the container.
FOLEYFLOW_LEDGER_PATH=
